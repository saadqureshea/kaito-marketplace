# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/kaito_marketplace

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Stripe (test mode) - checkout is currently wired to Stripe, not PayPal.
# Get a test secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key

# PayPal Sandbox (kept for the seller payout release in orderRoutes.js;
# checkout itself now runs through Stripe above)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MODE=sandbox

# Commission structure (documented, enforced in utils/commission.js)
MARKETPLACE_FEE_PERCENT=15
PAYMENT_PROCESSING_PERCENT=5
